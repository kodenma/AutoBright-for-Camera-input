<Window x:Class="AutoBrightnessApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoBrightnessApp.Controls"
        Title="AutoBright for Camera input" Height="940" Width="620"
        MinHeight="620" MinWidth="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="MasterToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#94A3B8" Padding="3">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              TextElement.FontWeight="Bold" TextElement.FontSize="13.5"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <!-- 最上部：アプリの有効/無効スイッチ & アプリ終了ボタン -->
            <Border x:Name="MasterEnableBanner" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <DockPanel>
                    <Button x:Name="ExitAppBtn" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Padding="12,5" FontSize="12" FontWeight="SemiBold"
                            Foreground="#DC2626" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            Cursor="Hand" Click="ExitApp_Click"/>
                    <CheckBox x:Name="MasterEnableSwitch" Style="{StaticResource MasterToggleSwitchStyle}" IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="MasterEnableSwitch_Changed" Unchecked="MasterEnableSwitch_Changed"/>
                </DockPanel>
            </Border>

            <!-- スタートアップ登録 & 言語切り替え -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                <DockPanel>
                    <CheckBox x:Name="StartupCheck" VerticalAlignment="Center" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                        <ComboBox x:Name="LanguageCombo" Width="155" DisplayMemberPath="NativeName" SelectedValuePath="Code"
                                  SelectionChanged="LanguageCombo_SelectionChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ステータス表示 -->
            <Border Background="#F3F6FA" BorderBrush="#D0D8E5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="StatusTitleText" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
                    <Button x:Name="MeasureNowBtn" Margin="0,10,0,0" Padding="10,5" HorizontalAlignment="Left" Click="MeasureNow_Click"/>
                </StackPanel>
            </Border>

            <!-- 1. カメラ・サンプリング・フィルター設定 -->
            <TextBlock x:Name="SectionCameraText" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="CameraLabelText" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <ComboBox x:Name="CameraCombo" Grid.Row="0" Grid.Column="1" Margin="0,2" SelectionChanged="CameraCombo_SelectionChanged"/>

                <TextBlock x:Name="ResolutionLabelText" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="1" Margin="0,2"/>

                <TextBlock x:Name="FlickerLabelText" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <ComboBox x:Name="FlickerCombo" Grid.Row="2" Grid.Column="1" Margin="0,2"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code"/>

                <CheckBox x:Name="ContinuousCheck" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center"
                          Checked="ContinuousCheck_Changed" Unchecked="ContinuousCheck_Changed"/>

                <TextBlock x:Name="IntervalLabelText" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0"/>
                <TextBox x:Name="IntervalBox" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="InputFilterLabelText" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0"/>
                <DockPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="InputFilterValueText" Width="26" TextAlignment="Right" FontWeight="Bold" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <Slider x:Name="InputFilterSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" ValueChanged="FilterSlider_ValueChanged"/>
                </DockPanel>

                <TextBlock x:Name="OutputFilterLabelText" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0"/>
                <DockPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="OutputFilterValueText" Width="26" TextAlignment="Right" FontWeight="Bold" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <Slider x:Name="OutputFilterSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" ValueChanged="FilterSlider_ValueChanged"/>
                </DockPanel>

                <CheckBox x:Name="DebugModeCheck" Grid.Row="7" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
            </Grid>

            <!-- 2. 輝度カーブグラフ設定 -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="SectionCurveText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button x:Name="ResetCurveBtn" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Click="ResetCurve_Click"/>
            </DockPanel>
            <TextBlock x:Name="CurveHintText" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <controls:BrightnessCurveEditor x:Name="CurveEditor" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

            <!-- 3. 過去5分間の測定履歴グラフ -->
            <TextBlock x:Name="SectionHistoryText" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <controls:MeasurementHistoryChart x:Name="HistoryChart" Height="175" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

            <!-- 4. モニター個別設定 -->
            <TextBlock x:Name="SectionMonitorsText" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <DataGrid x:Name="MonitorGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="100" Margin="0,0,0,16">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn x:Name="ColEnabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    <DataGridTextColumn x:Name="ColDisplayName" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn x:Name="ColOffset" Binding="{Binding BrightnessOffset, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 下部バー：「このアプリについて / About」ボタン & 保存ボタン -->
            <DockPanel>
                <Button x:Name="AboutBtn" Padding="14,7" HorizontalAlignment="Left" Click="About_Click"/>
                <Button x:Name="SaveBtn" Padding="16,7" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Save_Click"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>