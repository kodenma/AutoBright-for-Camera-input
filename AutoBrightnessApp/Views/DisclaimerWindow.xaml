<Window x:Class="AutoBrightnessApp.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoBright for Camera input" Height="520" Width="560"
        MinHeight="450" MinWidth="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー・作成者表示・言語選択 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AutoBright for Camera input" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="AuthorText" FontSize="12" Foreground="#475569" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="LanguageCombo" Width="155" DisplayMemberPath="NativeName" SelectedValuePath="Code"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- 概要・注意事項・免責事項本文 -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="OverviewTitleText" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="OverviewBodyText" TextWrapping="Wrap" FontSize="12.5" Foreground="#334155" Margin="0,0,0,14" LineHeight="19"/>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="CameraWarningTitleText" FontWeight="Bold" FontSize="13.5" Foreground="#991B1B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CameraWarningBodyText" TextWrapping="Wrap" FontSize="12.5" Foreground="#7F1D1D" LineHeight="19"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DisclaimerTitleText" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DisclaimerBodyText" TextWrapping="Wrap" FontSize="12.5" Foreground="#334155" LineHeight="19"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ボタン領域（初回起動時は「終了」「同意して開始」、About表示時は「閉じる」のみ） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ExitBtn" Padding="16,7" Margin="0,0,10,0" Click="Exit_Click"/>
            <Button x:Name="AgreeBtn" Padding="18,7" FontWeight="Bold" Background="#2563EB" Foreground="White" Click="Agree_Click"/>
            <Button x:Name="CloseBtn" Padding="20,7" FontWeight="Bold" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>