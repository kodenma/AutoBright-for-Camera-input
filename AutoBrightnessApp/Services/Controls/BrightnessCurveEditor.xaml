<UserControl x:Class="AutoBrightnessApp.Controls.BrightnessCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="230" MinWidth="420" FlowDirection="LeftToRight">
    <Border Background="White" BorderBrush="#C8D2E0" BorderThickness="1" CornerRadius="6" Padding="4">
        <Grid>
            <Canvas x:Name="PlotCanvas" Background="Transparent" ClipToBounds="True"
                    SizeChanged="PlotCanvas_SizeChanged"
                    MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                    MouseMove="PlotCanvas_MouseMove"
                    MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"/>
            <Border x:Name="CoordBadge" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#CC1E293B" CornerRadius="4" Padding="6,3"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0">
                <TextBlock x:Name="CoordText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</UserControl>